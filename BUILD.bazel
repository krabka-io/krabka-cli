"""Root package: the krabka operator CLI."""

package(default_visibility = ["//visibility:public"])

# Cargo.lock/Cargo.toml are consumed by `crate.from_cargo` (see //MODULE.bazel);
# clippy.toml by the lint aspect in //tools/lint; .cargo/mutants.toml by the
# mutation sweep, via `--@rules_rs_mutants//mutants:config` in //.bazelrc.
exports_files([
    ".cargo/mutants.toml",
    "Cargo.lock",
    "Cargo.toml",
    "clippy.toml",
])

# `bazel run //:krabka -- format --help`.
alias(
    name = "krabka",
    actual = "//crates/krabka-cli:krabka",
)

# `bazel run //:krabka-admin-ui -- --help`. Installed on PATH under this name,
# it is what `krabka admin-ui` runs.
alias(
    name = "krabka-admin-ui",
    actual = "//crates/admin-ui:krabka-admin-ui",
)
