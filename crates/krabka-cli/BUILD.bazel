load("//bazel:defs.bzl", "crate_binary", "crate_library", "crate_tests")
load("//tools/lint:linters.bzl", "clippy_test")

package(default_visibility = ["//visibility:public"])

# Consumed by `crate.from_cargo` (see //MODULE.bazel).
exports_files(["Cargo.toml"])

# The command surface: the clap types, each command's module, delegation and
# the exit-code vocabulary. `crate_library` also emits `krabka-cli_clippy` and
# `krabka-cli_doc`.
crate_library(
    name = "krabka-cli",
)

# `main.rs` only calls into the library, so it carries no `#[cfg(test)]`
# module and needs no test target of its own.
crate_binary(
    name = "krabka",
    crate_root = "src/main.rs",
    lib = ":krabka-cli",
    tests = False,
)

# `crate_library` lints itself. The binary is a separate compilation, so
# without this `main.rs` ships unlinted.
clippy_test(
    name = "krabka_clippy",
    srcs = [":krabka"],
)

crate_tests(
    # The suites under tests/ run the binary. rules_rust defines
    # `CARGO_BIN_EXE_<output basename>` for every bin crate named in `data`,
    # on the compile action, which is where `env!` reads it.
    data = [":krabka"],
    lib = "krabka-cli",
    # `conformance` compares every command with its `kafka-*` tool against a
    # Kafka container. Its comparison cases are `#[ignore]`d, so the plain
    # `conformance_test` runs only what needs no daemon -- the check that every
    # built-in command has a matrix, and the harness's own unit tests -- and
    # `conformance_docker_test` runs the rest after loading the digest-pinned
    # oracle image. `.bazelrc` keeps the latter, tagged `docker`, out of a plain
    # `bazel test //...`; `--config=docker` selects it.
    docker = {"conformance": ["apache_kafka_4_3_1"]},
    # The tag //bazel/images loads the oracle under, which the suite starts
    # with `--pull=never`. Under Cargo the suite pulls the pinned digest.
    env = {"KRABKA_ORACLE_IMAGE": "krabka-cli/conformance-oracle:apache-kafka-4.3.1"},
)
