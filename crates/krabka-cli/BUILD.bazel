load("@rules_rust//rust:defs.bzl", "rust_doc")
load("//bazel:defs.bzl", "crate_binary", "crate_tests")
load("//tools/lint:linters.bzl", "clippy_test")

package(default_visibility = ["//visibility:public"])

# Consumed by `crate.from_cargo` (see //MODULE.bazel).
exports_files(["Cargo.toml"])

# Binary-only: there is no `lib.rs`, so `format` and `ids` are modules of the
# binary rather than of a library beside it. `crate_tests` below takes this
# target's name in place of a library's -- `rust_test` over a binary compiles
# it with `--test` the same way.
crate_binary(
    name = "krabka",
    crate_root = "src/main.rs",
    # crate_tests emits the `#[cfg(test)]` target, so it is not wanted twice.
    tests = False,
)

crate_tests(
    # `format_smoke` runs the binary and reads back what it wrote. rules_rust
    # defines `CARGO_BIN_EXE_<output basename>` for every bin crate named in
    # `data`, on the compile action, which is where `env!` reads it.
    data = [":krabka"],
    lib = "krabka",
)

# `crate_library` emits these for every other crate in the organisation. With no
# library here they have to be asked for: without the first the binary ships
# unlinted, and without the second `//crates/...` renders no rustdoc at all and
# the docs job fails on an empty upload rather than on anything being wrong.
clippy_test(
    name = "krabka_clippy",
    srcs = [":krabka"],
)

rust_doc(
    name = "krabka_doc",
    crate = ":krabka",
)
